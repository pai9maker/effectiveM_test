# EffectiveTube configuration. Copy to .env and adjust, or let ./deploy.sh
# generate a production .env with random secrets.

APP_NAME=EffectiveTube
ENV=production
DEBUG=false
BASE_URL=http://localhost:8081
HTTP_PORT=8081

# Required: random 32+ byte value (openssl rand -hex 32)
SECRET_KEY=replace-with-openssl-rand-hex-32

# Required: database password used by the Postgres container
POSTGRES_PASSWORD=replace-with-random-password

# Required: S3 credentials shared by the app and SeaweedFS
S3_ACCESS_KEY=replace-with-random-access-key
S3_SECRET_KEY=replace-with-random-secret-key
S3_BUCKET=media

COOKIE_SECURE=false
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_DURATION_SEC=14400
TRANSCODE_TARGET_HEIGHT=720
DEMO_PASSWORD=DemoPass123!
